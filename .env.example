# Local-only example values. `pnpm setup` creates `.env` and generates a real
# BETTER_AUTH_SECRET when the file does not exist.
DATABASE_URL="postgresql://wholesale_ops:wholesale_ops@localhost:54329/wholesale_ops?schema=public"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-generated-local-secret-at-least-32-characters"
LOG_LEVEL="info"

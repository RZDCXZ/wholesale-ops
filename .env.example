# Safe local-only example values. `pnpm setup` copies this file to `.env` and
# replaces the placeholder with a randomly generated BETTER_AUTH_SECRET.
DATABASE_URL="postgresql://wholesale_ops:wholesale_ops@localhost:54329/wholesale_ops?schema=public"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-generated-local-secret-at-least-32-characters"
LOG_LEVEL="info"

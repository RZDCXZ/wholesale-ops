{
  "name": "wholesale-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "NO_PROXY=localhost,127.0.0.1 playwright test",
    "test:acceptance": "next build && cp -R .next/static .next/standalone/.next/ && corepack pnpm@11.21.0 demo:reset -- --yes && WHOLESALE_OPS_ACCEPTANCE=1 PLAYWRIGHT_SERVER_MODE=production NO_PROXY=localhost,127.0.0.1 playwright test",
    "db:start": "docker compose up -d --wait db",
    "db:stop": "docker compose down",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/demo-reset.ts --yes",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.4",
    "next": "16.3.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.13",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.0",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "testcontainers": "^11.12.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

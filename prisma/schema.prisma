generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  OWNER
  SALES
  WAREHOUSE
  FINANCE
}

enum InventoryMovementType {
  OPENING
  RESERVATION
  RELEASE
  OUTBOUND
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  OUTBOUND
  CANCELLED
}

enum ReceivableStatus {
  PENDING
  PARTIAL
  SETTLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  WECHAT
  ALIPAY
  OTHER
}

model User {
  id                   String              @id
  name                 String
  email                String              @unique
  emailVerified        Boolean             @default(false)
  image                String?
  enabled              Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sessions             Session[]
  accounts             Account[]
  roles                UserRole[]
  businessAudits       BusinessAudit[]
  dataImports          DataImport[]
  inventoryMovements   InventoryMovement[]
  responsibleCustomers Customer[]          @relation("CustomerResponsibleSales")
  createdSalesOrders   SalesOrder[]        @relation("SalesOrderCreator")
  recordedPayments     Payment[]
  paymentReversals     PaymentReversal[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserRole {
  userId String
  role   RoleCode
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_role")
}

model BusinessAudit {
  id            String   @id
  actorId       String
  actorName     String
  action        String
  objectType    String
  objectId      String
  occurredAt    DateTime @default(now())
  referenceCode String?
  reason        String?
  summary       String?
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([occurredAt])
  @@map("business_audit")
}

model DataImport {
  id                 String              @id
  importType         String
  fileName           String
  rowCount           Int
  actorId            String
  confirmedAt        DateTime            @default(now())
  actor              User                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]

  @@index([actorId])
  @@index([confirmedAt])
  @@map("data_import")
}

model Sku {
  id                 String              @id
  skuCode            String              @unique
  name               String
  category           String
  inventoryUnit      String
  referencePriceFen  Int
  warningThreshold   Int
  enabled            Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryBalance   InventoryBalance?
  inventoryMovements InventoryMovement[]
  salesOrderItems    SalesOrderItem[]

  @@index([name])
  @@index([category])
  @@index([enabled])
  @@map("sku")
}

model InventoryBalance {
  skuId            String   @id
  onHandQuantity   Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt
  sku              Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@map("inventory_balance")
}

model InventoryMovement {
  id               String                @id
  skuId            String
  movementType     InventoryMovementType
  onHandDelta      Int
  reservedDelta    Int
  onHandAfter      Int
  reservedAfter    Int
  occurredAt       DateTime              @default(now())
  relatedType      String
  relatedId        String
  relatedReference String?
  dataImportId     String?
  actorId          String
  actorName        String
  sku              Sku                   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  dataImport       DataImport?           @relation(fields: [dataImportId], references: [id], onDelete: Restrict)
  actor            User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([skuId, occurredAt])
  @@index([movementType, occurredAt])
  @@index([occurredAt])
  @@index([relatedType, relatedId])
  @@index([dataImportId])
  @@index([actorId])
  @@map("inventory_movement")
}

model Customer {
  id                 String       @id
  customerCode       String       @unique
  name               String
  contactName        String
  phone              String
  address            String
  responsibleSalesId String
  paymentTermDays    Int
  enabled            Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  responsibleSales   User         @relation("CustomerResponsibleSales", fields: [responsibleSalesId], references: [id], onDelete: Restrict)
  salesOrders        SalesOrder[]
  receivables        Receivable[]

  @@index([name])
  @@index([responsibleSalesId])
  @@index([enabled])
  @@map("customer")
}

model SalesOrder {
  id                           String           @id
  salesOrderNumber             String           @unique
  status                       SalesOrderStatus @default(DRAFT)
  customerId                   String
  creatorId                    String
  customerCodeSnapshot         String
  customerNameSnapshot         String
  customerContactNameSnapshot  String
  customerPhoneSnapshot        String
  customerAddressSnapshot      String
  responsibleSalesIdSnapshot   String
  responsibleSalesNameSnapshot String
  paymentTermDaysSnapshot      Int
  totalAmountFen               Int
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
  customer                     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator                      User             @relation("SalesOrderCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  items                        SalesOrderItem[]
  receivable                   Receivable?

  @@index([customerId])
  @@index([creatorId])
  @@index([responsibleSalesIdSnapshot])
  @@index([status, updatedAt])
  @@index([createdAt])
  @@map("sales_order")
}

model Receivable {
  id                         String           @id
  receivableNumber           String           @unique
  salesOrderId               String           @unique
  customerId                 String
  customerCodeSnapshot       String
  customerNameSnapshot       String
  responsibleSalesIdSnapshot String
  originalAmountFen          Int
  receivedAmountFen          Int              @default(0)
  remainingAmountFen         Int
  paymentTermDaysSnapshot    Int
  outboundAt                 DateTime
  dueDate                    DateTime         @db.Date
  status                     ReceivableStatus @default(PENDING)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  salesOrder                 SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer                   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments                   Payment[]
  paymentReversals           PaymentReversal[]

  @@index([customerId])
  @@index([responsibleSalesIdSnapshot])
  @@index([status, dueDate])
  @@index([outboundAt])
  @@map("receivable")
}

model Payment {
  id              String        @id
  receivableId    String
  paymentDate     DateTime      @db.Date
  amountFen       Int
  method          PaymentMethod
  referenceNumber String?
  note            String?
  idempotencyKey  String        @unique
  recordedAt      DateTime      @default(now())
  actorId         String
  actorName       String
  receivable      Receivable    @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  actor           User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reversal        PaymentReversal?

  @@index([receivableId, recordedAt])
  @@index([paymentDate])
  @@index([actorId])
  @@map("payment")
}

model PaymentReversal {
  id             String     @id
  paymentId      String     @unique
  receivableId   String
  amountFen      Int
  reason         String
  idempotencyKey String     @unique
  reversedAt     DateTime   @default(now())
  actorId        String
  actorName      String
  payment        Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receivable     Receivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  actor          User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([receivableId, reversedAt])
  @@index([actorId])
  @@map("payment_reversal")
}

model SalesOrderItem {
  id                        String     @id
  salesOrderId              String
  skuId                     String
  position                  Int
  skuCodeSnapshot           String
  skuNameSnapshot           String
  inventoryUnitSnapshot     String
  referencePriceFenSnapshot Int
  quantity                  Int
  transactionPriceFen       Int
  subtotalFen               Int
  salesOrder                SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  sku                       Sku        @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, position])
  @@unique([salesOrderId, skuId])
  @@index([skuId])
  @@map("sales_order_item")
}

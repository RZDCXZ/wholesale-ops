generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  OWNER
  SALES
  WAREHOUSE
  FINANCE
}

enum InventoryMovementType {
  OPENING
  RESERVATION
  RELEASE
  OUTBOUND
}

model User {
  id                   String              @id
  name                 String
  email                String              @unique
  emailVerified        Boolean             @default(false)
  image                String?
  enabled              Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sessions             Session[]
  accounts             Account[]
  roles                UserRole[]
  businessAudits       BusinessAudit[]
  dataImports          DataImport[]
  inventoryMovements   InventoryMovement[]
  responsibleCustomers Customer[]          @relation("CustomerResponsibleSales")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserRole {
  userId String
  role   RoleCode
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_role")
}

model BusinessAudit {
  id            String   @id
  actorId       String
  actorName     String
  action        String
  objectType    String
  objectId      String
  occurredAt    DateTime @default(now())
  referenceCode String?
  reason        String?
  summary       String?
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([occurredAt])
  @@map("business_audit")
}

model DataImport {
  id                 String              @id
  importType         String
  fileName           String
  rowCount           Int
  actorId            String
  confirmedAt        DateTime            @default(now())
  actor              User                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]

  @@index([actorId])
  @@index([confirmedAt])
  @@map("data_import")
}

model Sku {
  id                 String              @id
  skuCode            String              @unique
  name               String
  category           String
  inventoryUnit      String
  referencePriceFen  Int
  warningThreshold   Int
  enabled            Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryBalance   InventoryBalance?
  inventoryMovements InventoryMovement[]

  @@index([name])
  @@index([category])
  @@index([enabled])
  @@map("sku")
}

model InventoryBalance {
  skuId            String   @id
  onHandQuantity   Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt
  sku              Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@map("inventory_balance")
}

model InventoryMovement {
  id               String                @id
  skuId            String
  movementType     InventoryMovementType
  onHandDelta      Int
  reservedDelta    Int
  onHandAfter      Int
  reservedAfter    Int
  occurredAt       DateTime              @default(now())
  relatedType      String
  relatedId        String
  relatedReference String?
  dataImportId     String?
  actorId          String
  actorName        String
  sku              Sku                   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  dataImport       DataImport?           @relation(fields: [dataImportId], references: [id], onDelete: Restrict)
  actor            User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([skuId, occurredAt])
  @@index([movementType, occurredAt])
  @@index([occurredAt])
  @@index([relatedType, relatedId])
  @@index([dataImportId])
  @@index([actorId])
  @@map("inventory_movement")
}

model Customer {
  id                 String   @id
  customerCode       String   @unique
  name               String
  contactName        String
  phone              String
  address            String
  responsibleSalesId String
  paymentTermDays    Int
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  responsibleSales   User     @relation("CustomerResponsibleSales", fields: [responsibleSalesId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([responsibleSalesId])
  @@index([enabled])
  @@map("customer")
}
